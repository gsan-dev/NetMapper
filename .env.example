# --- Descubrimiento de redes (Fase 0) ---
# Lista blanca de seguridad: aunque se detecten más redes automáticamente,
# solo se escanean activamente (ARP/ICMP/puertos) las listadas aquí.
ALLOWED_NETWORKS=192.168.0.0/24,192.168.1.0/24,10.0.0.0/24

# SNMP a routers/switches gestionables (opcional, mejora la precisión)
SNMP_ENABLED=false
SNMP_COMMUNITY=public
SNMP_TIMEOUT_SECONDS=2

# --- Descubrimiento de hosts (Fase 1) ---
ARP_TIMEOUT_SECONDS=3
REMOTE_SCAN_TIMEOUT_SECONDS=1
REMOTE_SCAN_CONCURRENCY=100

# --- Caracterización de dispositivos (Fase 2) ---
PORT_SCAN_TIMEOUT_SECONDS=1
PORT_SCAN_CONCURRENCY=50
MDNS_ENABLED=true
MDNS_LISTEN_SECONDS=5

# --- Descubrimiento pasivo (Fase 3) ---
PASSIVE_CAPTURE_ENABLED=true
PASSIVE_CAPTURE_INTERFACE=eth0
PASSIVE_CAPTURE_WINDOW_SECONDS=30

# --- Orquestación del pipeline ---
SCAN_INTERVAL_SECONDS=300

# --- Base de datos ---
# "sqlite" (por defecto, funciona ya) o "neo4j" (stub para cuando quieras
# pasar a un grafo real con Cypher; ver Mejoras futuras en el README).
DB_BACKEND=sqlite
DB_PATH=./data/netmapper.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Análisis de grafo (Fase 5) ---
GATEWAY_IP=
GRAPH_ANALYSIS_INTERVAL_SECONDS=300

# --- Backend / API ---
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:5174

# --- Integración con NetGuardian (opcional, mejora futura ya implementada) ---
# Sondea el backend de NetGuardian (otro proyecto propio) para superponer
# sus alertas de anomalías de red sobre los dispositivos que NetMapper ya
# conoce por la misma IP.
NETGUARDIAN_ENABLED=false
NETGUARDIAN_API_URL=http://localhost:8000
NETGUARDIAN_USERNAME=admin
NETGUARDIAN_PASSWORD=
NETGUARDIAN_POLL_INTERVAL_SECONDS=60

# --- Detección de dispositivos no autorizados (mejora futura ya implementada) ---
# Lista blanca opcional de MACs conocidas/autorizadas. Vacía por defecto:
# nada se marca como no autorizado hasta que decides activarla.
ALLOWED_DEVICES=

# --- Identidad del sensor (para varios sensores en segmentos aislados) ---
SENSOR_ID=default

# --- Retención de snapshots (30 días por defecto) ---
GRAPH_SNAPSHOT_RETENTION_SECONDS=2592000

# --- Banner grabbing y TLS (Fase 2, activados por defecto) ---
BANNER_GRAB_ENABLED=true
BANNER_GRAB_TIMEOUT_SECONDS=1.5
TLS_INSPECT_ENABLED=true
TLS_INSPECT_TIMEOUT_SECONDS=2.0

# --- Correlación con CVEs vía NVD (opcional: hace peticiones salientes) ---
CVE_LOOKUP_ENABLED=false
CVE_LOOKUP_INTERVAL_SECONDS=86400
NVD_API_KEY=

# --- Detección de ARP/DHCP spoofing (pasiva, activada por defecto) ---
ARP_SPOOF_DETECTION_ENABLED=true

# --- Traceroute bajo demanda ---
TRACEROUTE_MAX_HOPS=30
TRACEROUTE_TIMEOUT_SECONDS=2.0

# --- Descubrimiento de topología física vía LLDP (pasivo) ---
LLDP_DISCOVERY_ENABLED=true
